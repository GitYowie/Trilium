{
  "version": 2,
  "targetNoteId": "4jDHmkMm5INE",
  "datasetType": "arrayOfObjects",
  "columns": [
    {
      "key": "domain",
      "type": "string",
      "required": true,
      "sortable": true,
      "validation": {
        "minLength": 2,
        "maxLength": 32,
        "pattern": "^[a-z0-9._-]+$",
        "messages": {
          "pattern": "Domain must be lowercase letters/numbers plus . _ -"
        }
      }
    },
    {
      "key": "id",
      "type": "string",
      "required": true,
      "sortable": true,
      "validation": {
        "minLength": 2,
        "maxLength": 64,
        "pattern": "^[A-Za-z0-9._:-]+$"
      }
    },
    {
      "key": "label",
      "type": "string",
      "required": true,
      "sortable": true,
      "validation": {
        "minLength": 2,
        "maxLength": 120
      }
    },
    {
      "key": "parentId",
      "type": "string|null",
      "required": false,
      "sortable": true
    },
    {
      "key": "sort",
      "type": "number",
      "required": true,
      "sortable": true,
      "validation": {
        "min": 0,
        "max": 10000
      }
    },
    {
      "key": "disabled",
      "type": "boolean",
      "required": true,
      "sortable": true,
      "validation": {
        "allowedValues": [
          true,
          false
        ]
      }
    },
    {
      "key": "meta.tagValue",
      "type": "string",
      "required": false,
      "sortable": true
    },
    {
      "key": "meta.items",
      "type": "json-array",
      "required": false,
      "sortable": false
    }
  ],
  "subgrids": {
    "meta.items": {
      "columns": [
        {
          "key": "name",
          "type": "string",
          "required": true,
          "validation": {
            "minLength": 2,
            "maxLength": 80
          }
        },
        {
          "key": "kind",
          "type": "string",
          "required": true,
          "optionsSource": "itemKinds",
          "validation": {
            "allowedValues": [
              "core",
              "addon",
              "external"
            ],
            "enumRequired": true,
            "messages": {
              "enumRequired": "Kind must be selected from the list.",
              "allowedValues": "Kind must be one of: core, addon, external."
            }
          }
        },
        {
          "key": "status",
          "type": "string",
          "required": false,
          "options": [
            {
              "value": "draft",
              "label": "Draft"
            },
            {
              "value": "active",
              "label": "Active"
            },
            {
              "value": "deprecated",
              "label": "Deprecated"
            }
          ],
          "validation": {
            "allowedValues": [
              "draft",
              "active",
              "deprecated"
            ]
          }
        },
        {
          "key": "kindMirror",
          "type": "string",
          "required": false,
          "optionsFromColumn": "kind"
        },
        {
          "key": "weight",
          "type": "number",
          "required": false,
          "validation": {
            "min": 0,
            "max": 1000
          }
        },
        {
          "key": "disabled",
          "type": "boolean",
          "required": false,
          "validation": {
            "allowedValues": [
              true,
              false
            ]
          }
        },
        {
          "key": "tags",
          "type": "json-array",
          "required": false,
          "subgrid": {
            "columns": [
              {
                "key": "label",
                "type": "string",
                "required": true,
                "validation": {
                  "minLength": 1,
                  "maxLength": 40
                }
              },
              {
                "key": "score",
                "type": "number",
                "required": false,
                "validation": {
                  "min": 0,
                  "max": 10
                }
              },
              {
                "key": "category",
                "type": "string",
                "required": true,
                "optionsSource": "tagCategories",
                "validation": {
                  "allowedValues": [
                    "ui",
                    "data",
                    "workflow"
                  ],
                  "enumRequired": true,
                  "messages": {
                    "enumRequired": "Category must be chosen from list.",
                    "allowedValues": "Category must be one of: ui, data, workflow."
                  }
                }
              }
            ],
            "optionSources": {
              "tagCategories": [
                {
                  "value": "ui",
                  "label": "UI"
                },
                {
                  "value": "data",
                  "label": "Data"
                },
                {
                  "value": "workflow",
                  "label": "Workflow"
                }
              ]
            }
          },
          "validation": {}
        }
      ],
      "optionSources": {
        "itemKinds": [
          {
            "value": "core",
            "label": "Core"
          },
          {
            "value": "addon",
            "label": "Add-on"
          },
          {
            "value": "external",
            "label": "External"
          }
        ]
      }
    }
  },
  "validation": {
    "uniqueKeys": [
      "domain",
      "id"
    ],
    "nesting": {
      "mode": "forbid",
      "allowObjectPaths": [
        "meta"
      ],
      "allowArrayPaths": [
        "meta.items"
      ]
    }
  }
}